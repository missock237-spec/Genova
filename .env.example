# ============================================================
# Gen3ia — Configuration d'environnement (Dev)
# Copier vers .env.local et adapter
# ============================================================

# ============================================================
# FIREBASE (remplace PostgreSQL/Prisma, NextAuth, fichier upload,
# notification engine, analytics custom)
# ============================================================

# --- Variables PUBLIQUES (exposées au navigateur, NEXT_PUBLIC_*) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Variables SERVEUR (Firebase Admin SDK) ---
# Format 1 (recommandé) : JSON complet du compte de service
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Format 2 : variables séparées
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ============================================================
# CACHE (Redis pour BullMQ / rate limiting — optionnel)
# ============================================================
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# ============================================================
# IA / LLM (serveur uniquement — NE PAS exposer avec NEXT_PUBLIC_)
# ============================================================
OPENAI_API_KEY=sk-votre-cle-ici
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici
GROQ_API_KEY=gsk-votre-cle-ici
HUGGINGFACE_TOKEN=hf_votre_token
HUGGINGFACE_API_KEY=${HUGGINGFACE_TOKEN}

# ============================================================
# CHARIOW — Passeur de paiement unique (Mobile Money Afrique + Carte)
# ============================================================
CHARIOW_API_KEY=
CHARIOW_WEBHOOK_SECRET=
CHARIOW_API_URL=https://api.chariow.com/v1
CHARIOW_PRODUCT_DEFAULT=
CHARIOW_PRODUCT_PLAN_FREE=
CHARIOW_PRODUCT_PLAN_STARTER=
CHARIOW_PRODUCT_PLAN_PRO=
CHARIOW_PRODUCT_PLAN_ENTERPRISE=
CHARIOW_PRODUCT_CREDITS_SMALL=
CHARIOW_PRODUCT_CREDITS_MEDIUM=
CHARIOW_PRODUCT_CREDITS_LARGE=
CHARIOW_PRODUCT_CREDITS_XLARGE=

# ============================================================
# EMAIL (serveur uniquement — utilisé par Firebase Auth pour les reset/verify)
# ============================================================
# --- Méthode recommandée : Resend API ---
# Obtenez votre clé sur https://resend.com/api-keys
RESEND_API_KEY=re_votre_cle_resend

# --- Adresse d'expédition (doit être un domaine vérifié sur Resend) ---
EMAIL_FROM=noreply@gen3ia.online
EMAIL_FROM_NAME=Gen3ia

# --- Fallback SMTP (si pas de RESEND_API_KEY) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=rezend
SMTP_PASS=
SMTP_FROM_EMAIL=${EMAIL_FROM}
SMTP_FROM_NAME=${EMAIL_FROM_NAME}
SMTP_SECURE=false

# ============================================================
# MONITORING
# ============================================================
SENTRY_DSN=https://xxx@xxx.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}
SENTRY_ORG=gen3ia
SENTRY_PROJECT=gen3ia-web
LOKI_URL=http://localhost:3100

# ============================================================
# RATE LIMITING (serveur uniquement — optionnel, Firebase App Check peut remplacer)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# CHIFFREMENT & SECURITE (serveur uniquement)
# ============================================================
VAULT_MASTER_KEY=hex-64-caracteres
SNYK_TOKEN=
ADMIN_EMAILS=admin@gen3ia.ai

# ============================================================
# DEVOPS — Clés API du système Développeurs
# ============================================================
# Sel pepperé utilisé pour hacher les clés API (scrypt) avant persistance
# dans Firestore (collection api_keys). Seule l'empreinte keyHash est
# stockée — JAMAIS la clé brute.
#
# - Générer un secret aléatoire :   openssl rand -hex 32
# - DOIT être identique entre la création, le runtime (Vercel) et le
#   script de migration (scripts/migrate-api-key-hash.ts), sinon les
#   clés migrées ne matcheront plus en production.
# - Changer ce secret révoque TOUTES les clés existantes (les utilisateurs
#   devront en recréer) : c'est la clé de rotation d'urgence.
API_KEY_HASH_SALT=hex-64-caracteres

# ============================================================
# COMPTE ADMIN MAÎTRE (bootstrap-admin.ts)
# ============================================================
#  Ce compte a TOUS les droits admin, et bénéficie gratuitement de
#  toutes les fonctionnalités du projet (crédits illimités, tous les
#  plans débloqués). Il est reconnu par cumul de critères confidentiels :
#  - Email (ADMIN_BOOTSTRAP_EMAIL)
#  - Mot de passe (ADMIN_BOOTSTRAP_PASSWORD — min 16 chars, complexe)
#  - Code confidentiel (ADMIN_BOOTSTRAP_CODE — min 32 chars, jamais
#    stocké en clair, uniquement hashé pbkdf2 100k itérations sha256
#    dans le runtime vault serveur)
#  - UID Firebase Auth dans ADMIN_BOOTSTRAP_UIDS (allowlist serveur)
#  - Custom claim Firebase customClaims.role === 'admin'
#
#  ⚠️  Ces variables ne doivent JAMAIS être commitées. À positionner
#      uniquement dans .env.production (ou les secrets Vercel).
#
#  Pour créer le compte admin :
#    npx tsx scripts/bootstrap-admin.ts
#
#  Le script affiche le UID à ajouter dans ADMIN_BOOTSTRAP_UIDS.
ADMIN_BOOTSTRAP_NAME=Gen3ia Admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_CODE=
# Renseigné APRÈS le premier bootstrap, contient le(s) UID(s) admin :
ADMIN_BOOTSTRAP_UIDS=

# ============================================================
# METRICS API KEY — pour scraping Prometheus (route /api/metrics)
# ============================================================
METRICS_API_KEY=

# ============================================================
# SECRETS INTERNES / CRON (serveur uniquement)
# 64 hex aléatoires chacun. Générer avec :
#   openssl rand -hex 32
# ============================================================
INTERNAL_SERVICE_SECRET=hex-64-caracteres
CRON_SECRET=hex-64-caracteres

# ============================================================
# CSP (Content-Security-Policy)
# Gérée par src/middleware.ts : CSP STRICT par NONCE, appliquée
# systématiquement en production. 'unsafe-inline'/'unsafe-eval' sont
# retirés de script-src (les scripts inline Next.js reçoivent le nonce
# automatiquement via l'header x-nonce). Aucune variable requise.
# ============================================================
# NEXT_PUBLIC_STRICT_CSP est OBSOLETE (toujours actif en production).
# NEXT_PUBLIC_STRICT_CSP=false

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ============================================================
# SMS ALERTS (TWILIO) — Alertes critiques par SMS
# ============================================================
# Active les notifications SMS pour les événements critiques
# (agent échoué, crédits épuisés, alerte sécurité, paiement reçu)
TWILIO_SMS_ENABLED=true
TWILIO_FROM_NUMBER=+1234567890

# ============================================================
# PHONE AUTH (SMS OTP) — Authentification par téléphone
# ============================================================
# Secret pour hasher les codes OTP (changez en production !)
OTP_HASH_SECRET=change-this-in-production

# ============================================================
# CAMPAY — Paiement Mobile Money (Cameroun) — Push USSD direct
# ============================================================
# Campay est un agrégateur de paiement camerounais qui envoie
# directement le prompt de paiement sur le téléphone (contrairement
# à Chariow qui redirige vers un site web).
# Inscription: https://campay.net
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_APP_ID=
CAMPAY_APP_TOKEN=
CAMPAY_API_URL=https://campay.net/api

# ============================================================
# WHATSAPP BUSINESS API — Canal de agents IA sur WhatsApp
# ============================================================
# WhatsApp est le canal de commerce dominant en Afrique.
# Permet de déployer les agents IA comme bots WhatsApp.
# Configurer via Meta Business: https://business.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_VERIFY_TOKEN=
